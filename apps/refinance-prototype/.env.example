# Staging deployment (npm run build:stage / npm run stage). MissionControl dev env.
VITE_MISSION_CONTROL_URL=http://localhost:3000

# Blinker Rails API (dev env, same backend MissionControl dev points at).
VITE_BLINKER_API_URL=http://localhost:4000

# Shared SSO cookie domain — parent of both subdomains so MissionControl and
# refi-portal read the same blinker_session cookie. Verify this matches the
# actual deployed hostnames before release.
VITE_SESSION_COOKIE_DOMAIN=localhost
