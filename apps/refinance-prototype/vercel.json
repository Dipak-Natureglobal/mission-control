{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "outputDirectory": "dist",
  "installCommand": "npx --yes pnpm@10.34.4 install --frozen-lockfile",
  "build": {
    "env": {
      "ENABLE_EXPERIMENTAL_COREPACK": "1"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
